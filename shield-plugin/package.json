{
  "name": "shield-quartz-plugin",
  "version": "0.1.0",
  "description": "ShieldFont transformer for Quartz v5: encodes marked text at build time via the Optik webfont",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup"
  },
  "quartz": {
    "name": "shield-plugin",
    "displayName": "ShieldFont",
    "category": "transformer",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {},
    "description": "Encodes text inside shield blocks (remark stage) so shipped HTML holds decoys."
  },
  "dependencies": {
    "@shieldfont/core": "^0.1.0",
    "unist-util-visit": "^5.1.0"
  },
  "peerDependencies": {
    "vfile": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "vfile": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  }
}